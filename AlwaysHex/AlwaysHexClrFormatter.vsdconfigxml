<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: MIT
  Copyright (c) 2026 Jochen Baier

  Second debug engine component of AlwaysHex (a .vsdconfig file holds one component). The
  build turns this file into AlwaysHexClrFormatter.vsdconfig, registered by the VSIX like
  AlwaysHex.vsdconfig.
-->
<Configuration xmlns="http://schemas.microsoft.com/vstudio/vsdconfig/2008">

  <DefineGuid Name="guidLanguageCSharp" Value="3F5162F8-07C6-11D3-9053-00C04FA302A1"/>
  <DefineGuid Name="guidVendorMicrosoft" Value="994B45C4-E6E9-11D2-903F-00C04FA302A1"/>
  <DefineGuid Name="guidAlwaysHexClrFormatterCompId" Value="B14F8D59-1E3B-414E-A914-781101E0C0A5"/>
  <!--
    C#: a server-side component (level below 100,000) just above Roslyn's C# result provider
    (63,000). It formats integer values where the text is produced instead of replacing results,
    so the C# result provider's own results reach Visual Studio (see AlwaysHexClrFormatter.cs).
  -->
  <ManagedComponent
    ComponentId="guidAlwaysHexClrFormatterCompId"
    ComponentLevel="63100"
    AssemblyName="AlwaysHex"
    Synchronized="false">
    <Class Name="AlwaysHex.AlwaysHexClrFormatter">
      <Implements>
        <InterfaceGroup>
          <Filter>
            <LanguageId RequiredValue="guidLanguageCSharp"/>
            <CompilerVendorId RequiredValue="guidVendorMicrosoft"/>
          </Filter>
          <Interface Name="IDkmClrFormatter"/>
          <Interface Name="IDkmClrFormatter2"/>
        </InterfaceGroup>
      </Implements>
    </Class>
  </ManagedComponent>
</Configuration>
