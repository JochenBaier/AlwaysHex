  C# test program for AlwaysHex (debugged by tests\3_test_debugger_values.ps1 -CSharp). Always built without
  optimizations so every local variable stays visible in the debugger. Output: tests\bin\TestCSharp.exe
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <!-- C# 9 or later for nint. -->
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>
